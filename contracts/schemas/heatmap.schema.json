{
  "$defs": {
    "CatchType": {
      "enum": [
        "asteroid",
        "near_earth_object",
        "trans_neptunian_object",
        "comet",
        "interstellar_object",
        "supernova",
        "active_galaxy",
        "tidal_disruption_event",
        "microlensing",
        "kilonova",
        "variable_star",
        "flare",
        "eclipsing_binary",
        "planet_candidate",
        "unknown"
      ],
      "title": "CatchType",
      "type": "string"
    },
    "HeatmapCell": {
      "additionalProperties": false,
      "properties": {
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/CatchType"
          },
          "title": "Counts",
          "type": "object"
        },
        "pix": {
          "minimum": 0,
          "title": "Pix",
          "type": "integer"
        }
      },
      "required": [
        "pix",
        "counts"
      ],
      "title": "HeatmapCell",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cells": {
      "items": {
        "$ref": "#/$defs/HeatmapCell"
      },
      "title": "Cells",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "grid": {
      "pattern": "^healpix nside=\\d+$",
      "title": "Grid",
      "type": "string"
    }
  },
  "required": [
    "generated_at",
    "grid",
    "cells"
  ],
  "title": "Heatmap",
  "type": "object"
}
