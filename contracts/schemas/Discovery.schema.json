{
  "$defs": {
    "CatchType": {
      "enum": [
        "asteroid",
        "near_earth_object",
        "trans_neptunian_object",
        "comet",
        "interstellar_object",
        "supernova",
        "active_galaxy",
        "tidal_disruption_event",
        "microlensing",
        "kilonova",
        "variable_star",
        "flare",
        "eclipsing_binary",
        "planet_candidate",
        "unknown"
      ],
      "title": "CatchType",
      "type": "string"
    },
    "Cutouts": {
      "additionalProperties": false,
      "properties": {
        "before": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before"
        },
        "difference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Difference"
        },
        "now": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Now"
        }
      },
      "title": "Cutouts",
      "type": "object"
    },
    "LightCurve": {
      "additionalProperties": false,
      "properties": {
        "flux": {
          "items": {
            "type": "number"
          },
          "maxItems": 2000,
          "title": "Flux",
          "type": "array"
        },
        "time_btjd": {
          "items": {
            "type": "number"
          },
          "maxItems": 2000,
          "title": "Time Btjd",
          "type": "array"
        }
      },
      "required": [
        "time_btjd",
        "flux"
      ],
      "title": "LightCurve",
      "type": "object"
    },
    "Link": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "label",
        "url"
      ],
      "title": "Link",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "cutouts": {
      "$ref": "#/$defs/Cutouts"
    },
    "dec_deg": {
      "maximum": 90,
      "minimum": -90,
      "title": "Dec Deg",
      "type": "number"
    },
    "detected_at": {
      "format": "date-time",
      "title": "Detected At",
      "type": "string"
    },
    "explanation": {
      "title": "Explanation",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "known_status": {
      "enum": [
        "known",
        "not_on_lists",
        "unchecked"
      ],
      "title": "Known Status",
      "type": "string"
    },
    "light_curve": {
      "anyOf": [
        {
          "$ref": "#/$defs/LightCurve"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "links": {
      "items": {
        "$ref": "#/$defs/Link"
      },
      "title": "Links",
      "type": "array"
    },
    "name_if_known": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name If Known"
    },
    "origin": {
      "title": "Origin",
      "type": "string"
    },
    "ra_deg": {
      "exclusiveMaximum": 360,
      "minimum": 0,
      "title": "Ra Deg",
      "type": "number"
    },
    "raw": {
      "additionalProperties": true,
      "title": "Raw",
      "type": "object"
    },
    "source": {
      "enum": [
        "rubin",
        "tess"
      ],
      "title": "Source",
      "type": "string"
    },
    "type": {
      "$ref": "#/$defs/CatchType"
    }
  },
  "required": [
    "id",
    "type",
    "confidence",
    "source",
    "origin",
    "ra_deg",
    "dec_deg",
    "detected_at",
    "known_status",
    "cutouts",
    "explanation"
  ],
  "title": "Discovery",
  "type": "object"
}
